{
  "name": "pangram-cli-development-tools",
  "private": true,
  "type": "module",
  "workspaces": [
    "docs-app",
    "npm/pangram-cli"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "docs:build": "npm run generate -w docs-app && npm run build -w docs-app",
    "docs:check": "npm run docs:generate && node --test scripts/check-docs.test.mjs && node scripts/check-docs.mjs && npm run check -w docs-app",
    "docs:generate": "node scripts/generate-docs.mjs",
    "docs:typecheck": "npm run generate -w docs-app && npm run typecheck -w docs-app",
    "packages:check": "node scripts/check-packaging.mjs",
    "tegami": "node scripts/tegami.mts",
    "test:mcp-conformance": "vitest run tools/mcp-conformance/applicability.test.ts --no-file-parallelism",
    "test:tui": "vitest run tools/tui-acceptance/tui-acceptance.test.ts --no-file-parallelism"
  },
  "devDependencies": {
    "@kitlangton/terminal-control": "0.6.0",
    "@modelcontextprotocol/conformance": "0.2.0-alpha.11",
    "parse5": "7.3.0",
    "remark-gfm": "4.0.1",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "tegami": "1.4.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "vitest": "3.2.7"
  }
}
