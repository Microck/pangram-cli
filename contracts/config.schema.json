{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pangram CLI configuration v1",
  "type": "object",
  "properties": {
    "config_version": {
      "const": 1
    },
    "history": {
      "anyOf": [
        {
          "$ref": "#/$defs/HistoryConfig"
        }
      ]
    },
    "tui": {
      "anyOf": [
        {
          "$ref": "#/$defs/TuiConfig"
        }
      ]
    },
    "updates": {
      "anyOf": [
        {
          "$ref": "#/$defs/UpdatesConfig"
        }
      ]
    },
    "network": {
      "anyOf": [
        {
          "$ref": "#/$defs/NetworkConfig"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "config_version"
  ],
  "$defs": {
    "HistoryConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": [
            "boolean"
          ],
          "default": false
        }
      },
      "additionalProperties": false
    },
    "TuiConfig": {
      "type": "object",
      "properties": {
        "intro": {
          "anyOf": [
            {
              "$ref": "#/$defs/IntroMode"
            }
          ],
          "default": "once"
        },
        "keymap": {
          "anyOf": [
            {
              "$ref": "#/$defs/Keymap"
            }
          ],
          "default": "regular"
        },
        "motion": {
          "anyOf": [
            {
              "$ref": "#/$defs/Motion"
            }
          ],
          "default": "full"
        }
      },
      "additionalProperties": false
    },
    "IntroMode": {
      "type": "string",
      "enum": [
        "once",
        "always",
        "off"
      ]
    },
    "Keymap": {
      "type": "string",
      "enum": [
        "regular",
        "vim"
      ]
    },
    "Motion": {
      "type": "string",
      "enum": [
        "full",
        "reduced",
        "off"
      ]
    },
    "UpdatesConfig": {
      "type": "object",
      "properties": {
        "check_on_tui_start": {
          "type": [
            "boolean"
          ]
        }
      },
      "additionalProperties": false
    },
    "NetworkConfig": {
      "type": "object",
      "properties": {
        "max_requests_per_second": {
          "type": [
            "number"
          ],
          "format": "double",
          "maximum": 5.0,
          "exclusiveMinimum": 0,
          "default": 5
        }
      },
      "additionalProperties": false
    }
  },
  "$id": "https://pangram.micr.dev/schemas/config-v1.json",
  "x-contract-owner": "rust:microck_pangram_cli::contracts"
}
