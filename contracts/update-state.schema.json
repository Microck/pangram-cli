{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pangram local update-check state v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "last_checked_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "etag": {
      "type": [
        "string"
      ]
    },
    "available_version": {
      "type": [
        "string"
      ],
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "last_checked_at"
  ],
  "$id": "https://pangram.micr.dev/schemas/update-state-v1.json",
  "x-contract-owner": "rust:microck_pangram_cli::contracts"
}
