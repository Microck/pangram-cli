{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pangram local update-check state v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "last_checked_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "etag": {
      "type": [
        "string"
      ]
    },
    "available_version": {
      "anyOf": [
        {
          "$ref": "#/$defs/SemVerString"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "last_checked_at"
  ],
  "$defs": {
    "SemVerString": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(\\+([0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*))?$"
    }
  },
  "$id": "https://pangram.micr.dev/schemas/update-state-v1.json",
  "x-contract-owner": "rust:microck_pangram_cli::contracts"
}
