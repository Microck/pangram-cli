{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pangram direct-install receipt v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "method": {
      "const": "direct"
    },
    "executable_path": {
      "type": "string",
      "minLength": 1
    },
    "installed_version": {
      "$ref": "#/$defs/SemVerString"
    },
    "target": {
      "$ref": "#/$defs/Target"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "executable_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "installed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "method",
    "executable_path",
    "installed_version",
    "target",
    "manifest_sha256",
    "executable_sha256",
    "installed_at"
  ],
  "$defs": {
    "SemVerString": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(\\+([0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*))?$"
    },
    "Target": {
      "type": "string",
      "enum": [
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
        "x86_64-apple-darwin",
        "aarch64-apple-darwin",
        "x86_64-pc-windows-msvc"
      ]
    }
  },
  "$id": "https://pangram.micr.dev/schemas/install-receipt-v1.json",
  "x-contract-owner": "rust:microck_pangram_cli::contracts"
}
