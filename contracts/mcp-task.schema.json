{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pangram.micr.dev/schemas/mcp-task-v1.json",
  "x-contract-owner": "specification-seed",
  "title": "Pangram MCP task using MCP 2025-11-25",
  "type": "object",
  "required": [
    "taskId",
    "status",
    "createdAt",
    "lastUpdatedAt",
    "ttl"
  ],
  "properties": {
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "working",
        "input_required",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "statusMessage": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "lastUpdatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "ttl": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "pollInterval": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": true
}
