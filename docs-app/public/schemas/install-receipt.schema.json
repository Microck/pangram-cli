{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"Pangram direct-install receipt v1","description":"Owner-only evidence that the current executable came from a direct install.","type":"object","properties":{"schema_version":{"const":"1"},"method":{"const":"direct"},"executable_path":{"type":"string","minLength":1},"installed_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},"target":{"$ref":"#/$defs/Target"},"manifest_sha256":{"$ref":"#/$defs/Sha256Hash"},"installed_at":{"$ref":"#/$defs/UtcTimestamp","pattern":"Z$"}},"additionalProperties":false,"required":["schema_version","method","executable_path","installed_version","target","manifest_sha256","installed_at"],"$defs":{"Target":{"description":"Release target identifiers accepted by the signed manifest.","type":"string","enum":["x86_64-unknown-linux-gnu","aarch64-unknown-linux-gnu","x86_64-apple-darwin","aarch64-apple-darwin","x86_64-pc-windows-msvc"]},"Sha256Hash":{"description":"A lowercase SHA-256 digest.","type":"string","pattern":"^[0-9a-f]{64}$"},"UtcTimestamp":{"description":"An absolute UTC timestamp in the canonical `Z` form.","type":"string","format":"date-time","pattern":"Z$"}},"$id":"https://pangram.micr.dev/schemas/install-receipt-v1.json","x-contract-owner":"rust:microck_pangram_cli::contracts"}
